# title: 町田・深夜のEM変死事件「町田に消ゆ」 ― 第一章「町田」
// =====================================================================
//  ※本作はフィクション。登場人物・団体・出来事は実在のいかなるものとも無関係。
//    被害者・小田中育生は実在のエンジニア氏へのオマージュ（メタル/アジャイル/
//    北の出身という人となりを敬意を込めて借りるのみ）。本作の小田中は加害者では
//    なく、過去の隠蔽の当事者でもない（隠蔽したのは倉田ら別人）。彼はむしろ、
//    かつて声を上げられなかった悔いから、最後に真実を暴こうとして殺される側。
//  「旅するミステリ」全4章の第1章（縦スライス）。
//  全体構想は memory:machida-em-okhotsk を参照（章＝土地。現在の殺人の根は
//  過去の"隠蔽事件"にある。トーン重め・社会派。終着＝東京へ帰還し、ORACLE(AI×金×政治の
//  自動化された汚職)を止め、黒幕を暴く。DANFORTH＝海外の金主として背後に残す）。
//
//  ＜プレイヤー＝所轄の刑事。被害者・小田中とはつくば時代の旧友（公の権限＋私的動機）。
//    旧友からエンジニアリングを聞かされ続けた素地ゆえ、コミット/ログ/ボットの作為も読める。
//    東京帰還(終章)・椿の自死(3章)・AIいくお継承は、この"旧知"が動機の芯になる。＞
//  ＜固定コマンド（調査パレット）＞
//   あたりをみる / しらべる→対象 / きく→人物 / ばしょいどう→場所 /
//   てちょう（手帳：物証・捜査メモ）
//   ＊章末の移動先（次の土地）は、必須T1が揃うと「ばしょいどう」に出現＝それが合図。
//   ＊この章では犯人を挙げない。決め手＝立件は終章（東京帰還）。
//    第1章のゴール＝「事故では片づかない」疑念を物証で積む（殺人とも事件性とも断定しない）。
//    解剖前の初動という設定ゆえ、章末も"疑念止まり"でもやっと残す。過去への扉を開いて終わる。
//
//  ＜フラグ＝手帳の「捜査メモ」「物証アイテム」として可視化＞
//   必須T1（8）＝事件の像。全部揃うと「町田を発つ」が解禁（章ゲート。
//     丁寧に調べれば必ず揃う＝ソフトロック無し）。
//   引き継ぎ（3・奥まった/推理）＝真EDの鍵。取り逃しても発てるが、
//     全章で取り切らないと終章の真EDに届かない。2章以降へ持ち越す。
//
//  必須T1メモ/物証(9):
//   m_lastday 当日の足取り(被害者起点・聞き込みの前提) / m_wound 創傷の不一致 /
//   m_floor 血痕の不在 / m_drag 引きずり痕 / m_scene 真の現場 /
//   it_bar 凶器(金属バー) / m_cleanup 後始末痕 / m_timeline 在館タイムライン /
//   it_draft 盗用告発の草稿
//  引き継ぎ:
//   m_gap 経歴の空白(推理) / it_token 過去の符牒(奥まった)
//
//  ＜真相（実装者向け・プレイ時伏せる／封印層）＞
//   死因は事故偽装、真の犯行現場はサーバ室、遺体は個室へ移動。真犯人と決め手は
//   終章で確定するため本章では伏せる。第1章は「転倒では説明がつかない疑念（遺体移動・凶器・
//   後始末・表の動機）」を積むに留め、断定しない。被害者の前職（機密流出の隠蔽の地）への手がかりを残す。
//
//  場所: 1=個室(現場) 2=開発フロア 3=サーバ室 4=廊下 5=警備室 6=給湯室
//  人物: 1=真鍋誠 2=西野薫 3=沢田亮 4=東巧 5=倉持百合
// =====================================================================

VAR loc = 1
VAR place = "小田中の個室"

// --- 必須T1（9）---
VAR m_lastday = false    // 当日の足取り：手帳/予定表。22時以降が白紙＝予定外の動き
VAR m_wound = false      // 創傷の所見：二度打撲・机角と不一致
VAR m_floor = false      // 血痕の不在：ここで倒れていない
VAR m_drag = false       // 引きずり痕：遺体は運ばれた
VAR m_scene = false      // 真の現場：サーバ室
VAR it_bar = false       // 物証：非常用金属バー（凶器）
VAR m_cleanup = false    // 後始末痕：給湯室の濡れペーパー
VAR m_timeline = false   // 在館タイムライン：入退館＋カメラ
VAR it_draft = false     // 物証：小田中の私的メモ（独りで何かを調べた形跡）

// --- 引き継ぎ（2・奥まった/推理）---
VAR m_gap = false        // 経歴の空白（推理：表彰盾×在籍記録）
VAR it_token = false     // 過去の符牒（奥まった：海外・機密の気配）
VAR it_note = false      // 千切れた走り書き①「鍵は、ふたつ。ひとつめは——」＋『[』のような線（Ch1サーバ室。Ch4 e4_tokenで取り逃し救済。スコア対象外）
VAR it_note2 = false     // 千切れた走り書き②『)』のような弧＋「ふたつめは、おれたちの、あの一曲。」（Ch4隠れ家。合体演出・コマンドは置かない＝[+)=D は読者の内心のみ）

// --- 推理の素材（生の手がかり。単体では手帳に残らない）---
VAR r_oldjob = false     // 表彰盾に前職名
VAR r_tenure = false     // 在籍記録に不自然な空白

// --- 進行 ---
VAR chapter = 1               // 1=町田 / 2=東京・現職
VAR m_hq_lead = false         // 東のタレこみ：渋谷本社に手がかり（渋谷行きの動機・章ゲート）

// =====================================================================
//  第二章「東京・現職」（渋谷本社）の状態
//   ＜パズル＝古典暗号（グロンスフェルト）を既知平文攻撃で割る＞
//     背景：現職の主力プロダクトは、前職オリオン計画（つくば・テクスフィア）から
//       倉田が横領した資産 orion の上に建つ。倉田は表層を改名して隠したが、深層の
//       封印アーカイブ（当時の機密規約で暗号化されたファイル群）は消せずに残る。
//     封印＝各ファイルのタイトル(平文8文字ローマ字)を、通し番号3桁を鍵とする
//       グロンスフェルト暗号（各桁だけ後方へずらす）で綴った"暗号名"を打ち込めば開く。
//       鍵規約を知るのは倉田だけ。だが公開文書(議事録/覚書/稟議書)と封印時の暗号名が
//       事務作業の副産物として同じ場所に取り残されている＝既知平文3ペア。
//       ＜平文↔暗号文＞3組から「番号の各桁でずらす」規則を帰納し、本命『総括』の
//       暗号名を自力で綴る。開くと来歴＝オリオン計画の名がゲームで初めて表に出る。
//     実データ：#017 GIJIROKU→GJQISVKV ／ #042 OBOEGAKI→OFQEKCKM ／
//       #308 RINGISYO→UIVJIABO ／ 本命 #205 SOUKATSU→UOZMAYUU（8枠×正解1＋無作為5）。
//     ＊主人公は非エンジニア。やるのは紙と鉛筆の突き合わせ（換字暗号を割る古典探偵仕事）。
//     ＊「きく」は暗号に非関与（規約を知る者がいない）。素材は必ず「しらべる（資料）」から漏出。
// 作業
VAR m2_pw_ok = true           // 暗号入力：8枠すべて正しければ true のまま（1枠でも誤で false）
// 必須T2（6）
VAR m2_theft = false          // 小田中の夜間アクセス痕（職務外のorion領域へ深夜に独り）＝導入
VAR m2_hush = false           // 倉田の口頭門前払い＝orionは"誰にも訊けない質問"（人の壁）
VAR m2_report = false         // つきつけ速水で割れる：通報の後ろめたさ＋倉田の常置命令→閲覧を通す
VAR m2_vault = false          // orion深層の封印アーカイブ発見（ヘッダ平文・中身は暗号）
VAR m2_pair1 = false          // 既知平文①：議事録 GIJIROKU #017 ↔ 暗号名 GJQISVKV（人事・受入票）
VAR m2_pair2 = false          // 既知平文②：覚書 OBOEGAKI #042 ↔ 暗号名 OFQEKCKM（段ボール・付箋）
VAR m2_pair3 = false          // 既知平文③：稟議書 RINGISYO #308 ↔ 暗号名 UIVJIABO（端末・移行ログ）
VAR m2_crack = false          // 本命『総括』SOUKATSU #205 を開封（暗号名 UOZMAYUU）＝来歴＝オリオン計画
VAR m2_keyperson = false      // 開封資料の名簿→人事で経歴追跡→前職キーパーソン（つくばへの糸）
// 引き継ぎ（3・真EDの鍵）
VAR d2_suicide = false        // 過去に告発者が自死していた最初の影
VAR d2_secret = false         // 機密（輸出規制/DANFORTH）に触れていた確証
VAR d2_seed = false           // 終章への微かな違和（奥まった）
// つきつける
VAR accuse2 = 0
VAR evk2 = 0

// =====================================================================
//  第三章「つくば」（前職テクスフィアの地・盟友の自死の真相・小田中の原点）
//   ＜トリック＝嘘つき/証言の矛盾（演繹的再構成）＞ Ch1観察・Ch2帰納とは別系統。
//     盟友・椿直人の「自死」の夜、当時の関係者の証言が食い違う。物証（椿の遺した
//     KPTノートの最後の日付＋旧オフィスの来訪記録）と突き合わせ、高梨の嘘を暴く。
//     決め手＝矛盾の物証（来訪記録）を高梨に「つきつける」と割れる。
//   ＜人となり＞ 小田中＝"カイゼンの鬼"(アジャイル)なのに過去だけ放置した悔い。
//     メタルが盟友との符牒。新潟は二人の原点（彩り・里帰り）。
VAR r3_visit = false          // 旧オフィスの来訪記録（高梨が死亡時刻まで在館）
VAR t3_takagi = false
VAR t3_takizawa = false
VAR m3_orion = false          // オリオンの機密インシデントの実在
VAR m3_friend = false         // 盟友＝椿直人（告発しようとした技術者）特定
VAR m3_kpt = false            // 椿の遺したKPTノート（物証・隠し書きの気配）
VAR m3_metal = false          // メタルの符牒（隠し書きの鍵）
VAR m3_decode = false         // KPTの隠し書き解読＝椿はDANFORTH取引の証拠を握っていた
VAR m3_testimony = false      // 当時の関係者の証言（高梨＆滝沢）
VAR m3_contradiction = false  // 証言×物証で矛盾を特定（高梨が嘘）
VAR m3_truth = false          // つきつけで高梨を割り、死の真相を確定
VAR d3_us = false             // 椿の証拠が指す先＝東京のORACLE本体（海外金主DANFORTHと結ぶ）→終章
VAR d3_seed = false           // 真犯人への布石（封印寄り・奥まった）
VAR d3_niigata = false        // 新潟の彩り：椿と小田中の原点（里帰り）
VAR r3_hometown = false       // 椿と小田中の故郷＝新潟と判明（楢崎）。新潟（実家・土手）解禁
VAR d3_hideout = false        // 郷田の発送控え：町田の隠れ家の住所（t3完了後の再訪で取得＝章ゲート）
VAR accuse3 = 0
VAR evk3 = 0

// =====================================================================
//  終章「東京（帰還）」（事件解決＝プレイヤーの推理／ORACLE阻止＝AIいくお。2軸4ルート）
//   ＜ORACLE＞ オリオンの予測技術の進化形＝要人の弱みを採点し金と弱みで政治を動かす"自動化された汚職"。
//     西野が現職企業で設計・運用。DANFORTH＝海外の金主/データ源。椿・小田中はこれを止めようとして殺された。
//   ＜AIいくお＞ 椿と小田中がORACLEを止めるために作った対抗AI。起動キー＝半券(it_token)＋符牒(m3_metal)。
//     事件の謎解きには一切関与しない（時系列的に事件後を知り得ないため）。ORACLE阻止＝ai_booted で分岐。
//   ＜真犯人＝西野＞ プレイヤー自身の手帳推理（"サーバ室"の言い漏らし＝不可能知識）。AIいくお不要。
//   ＜4ルート＞ 1.沢田だけ(そうさをやめる) / 2.沢田+ORACLE失敗(未起動で踏み込む) /
//     3.沢田+ORACLE阻止(起動・黒幕未看破) / 4.沢田+西野+ORACLE阻止(真)。全ルートで沢田は立件済み。
VAR ai_booted = false         // 起動成功（= it_token && m3_metal を満たした）
VAR it_nishino = false        // 第2章で西野が"協力するふり"でそっと渡す私物（カモフラージュした偽の鍵／提示するとバッドエンド）
VAR it_photo = false          // 椿のロッカーの写真（椿＋"もう一人"＝西野）。d3_seedと同時取得・西野立件の決め手の片割れ
VAR k1 = 0                    // ラップトップ提示：1つ目（作業変数。起動・真ED共用）
VAR k2 = 0                    // ラップトップ提示：2つ目（作業変数。起動・真ED共用）
// Phase A（全ED共通の推理：実働者を特定して検挙）
VAR m4_sawada = false         // 実働者＝沢田を検挙（"下っ端検挙"＝全EDの達成土台）
// Phase B（"裏切りの協力者"を暴く推理。プレイヤー自身が手帳を読み返す。AIいくお不要）
VAR heard_slip = false        // Ch2で西野の"サーバ室"の言い漏らしを聞いた（不可能知識の素材）
VAR m4_proof = false          // 起動したいくおがUSB＋写真を判定し、USBに西野立件の決定的証拠を書き込んだ
// 終章の「つきつける」（実働者も黒幕も共通コマンドで名指し）
VAR accuse4 = 0               // 突きつける相手（1真鍋/2西野/3沢田/4東/5倉持/6倉田/7高梨/8ラップトップ）
VAR evi4 = 0                  // 終章つきつけの提示物（1警報/2監査ログ/3鑑識/4半券/5私的メモ/6預かりUSB/7KPT/8走り書き①/9走り書き②）
// --- 終章「町田（帰還・再捜査）」用（AIいくお/ORACLE/西野の山とは独立） ---
VAR r4_plan = false           // 隠れ家：小田中の計画判明（裏口をサーバ室で開けに行った）＝殺しはサーバ室と確信＋動機
VAR r4_session = false        // サーバ室再検証：小田中が最後に触れた端末セッション（裏口を開けた証）
VAR r4_alert = false          // 警備室再検証：ストレージ警報は館内＝サーバ室から焚かれた（沢田の"呼ばれた"アリバイ捏造）
VAR r4_guard = false          // 倉持に聞いて警報のリードを得た（警備室の発報記録を見る動機。r4_plan後のみ成立）
VAR r4_wire_lead = false      // 東に聞いて、沢田がサーバ室で配線をいじっていたと知った（m4_sawada後のみ成立）
VAR r4_wire = false           // サーバ室で沢田が外した配線をつなぎ直した（AIいくお起動の物理前提）
VAR r4_forge_lead = false     // 発報記録×在館タイムラインの矛盾＝入退館の記録を調べ直す動機（断定はしない）
VAR r4_db_access = false      // 真鍋の手配（情シス経由）で入退館DBの閲覧アカウントを得た
VAR r4_entrylog = false       // 監査ログ：沢田の退館・入館レコードはサーバ室のローカルコンソールから直接書き込まれた偽物
VAR r4_forensic = false       // 鑑識報告（捜査本部）：金属バーに血液反応・DNA一致・柄は拭われ指紋なし

VAR public_status = "place"

-> intro

// =====================================================================
=== function bool_to_n(b) ===
{ b:
    ~ return 1
}
~ return 0

=== function t1_complete() ===
~ return m_lastday && m_wound && m_floor && m_drag && m_scene && it_bar && m_cleanup && m_timeline && it_draft

=== function deep_count() ===
~ return bool_to_n(m_gap) + bool_to_n(it_token)

=== function t2_complete() ===
~ return m2_theft && m2_hush && m2_report && m2_vault && m2_crack && m2_keyperson

=== function deep2_count() ===
~ return bool_to_n(d2_suicide) + bool_to_n(d2_secret) + bool_to_n(d2_seed)

=== function who2(c) ===
{
- c == 1: ~ return "西野"
- c == 2: ~ return "速水"
- c == 3: ~ return "倉田"
- c == 4: ~ return "真壁"
- else:   ~ return "その人物"
}

=== function t3_complete() ===
~ return m3_orion && m3_friend && m3_kpt && m3_metal && m3_decode && m3_testimony && m3_contradiction && m3_truth

=== function deep3_count() ===
~ return bool_to_n(d3_us) + bool_to_n(d3_seed) + bool_to_n(d3_niigata)

=== function who3(c) ===
{
- c == 1: ~ return "高梨"
- c == 2: ~ return "滝沢"
- else:   ~ return "その人物"
}

=== function who4(c) ===
{
- c == 1: ~ return "真鍋"
- c == 2: ~ return "西野"
- c == 3: ~ return "沢田"
- c == 4: ~ return "東"
- c == 5: ~ return "倉持"
- c == 6: ~ return "倉田"
- c == 7: ~ return "高梨"
- else:   ~ return "その人物"
}

// 第3章：盟友の名「椿」は特定（m3_friend）するまで伏せる。未特定なら「盟友」と呼ぶ。
=== function tomo() ===
{
- m3_friend: ~ return "椿"
- else:      ~ return "盟友"
}

=== function deep_total() ===
~ return deep_count() + deep2_count() + deep3_count()

=== function enough_truth() ===
~ return deep_total() >= 7

// =====================================================================
=== intro ===
※本作はフィクションです。登場する人物・団体・出来事は、実在のいかなるものとも関係ありません。

前夜遅く、町田駅から徒歩10分、雑居ビル7階の開発オフィス。残業の波は時間をかけて引いていき、社員たちは既に帰路についていた。
深夜、ストレージ警報で呼び戻された当番の社員が、通路の奥——用がなければ誰も足を向けない、閉じた小部屋に灯りを見つける。中で、Engineering Manager・小田中育生(42)が倒れていた。
すぐに119番。だが駆けつけた救急隊が確認したのは、もう手の施しようのない事実だった——体は冷え、硬直が始まっていた。明らかな死。搬送はされず、こんどは110番が回される。
病死でも、ひと目で分かる事故でもない——医者の看取らぬ死は、ひとまず「変死」として扱われる。所轄が臨場し、検視官が呼ばれ、遺体はそのまま、現場は保全された。事件性の有無を見極める。それが初動だ。

未明。応援に駆けつけたあなたは、遺体の顔に、息が止まった。
つくばで机を並べた、古い友人だ。十年も会っていない。だが、カイゼンだアジャイルだと一晩じゅう語り倒したあの男を、忘れるはずがない。
私情は、伏せておく。今は一人の捜査官として、現場を踏む。まずは状況からだ。
-> prologue_brief

=== prologue_brief ===
検視官が遺体の傍らで顔を上げた。「外表所見では、致命傷は後頭部の打撲。転倒して机の角に頭を強く打ちつけたことによるものとみております。——ただ、確定は解剖を待ってください」。机の角には、確かに血。
「死亡推定は」。「体温と硬直からみて、死後およそ2、3時間。前夜の22時から23時のあたりでしょう。見つかったのが0時前ですから、亡くなってからしばらく、誰にも気づかれずにいた計算です」。
あの晩はリリースの夜。社員たちは21時台から順に引き上げ、死亡推定の頃にフロアに残っていたのは、彼一人のようだ。しかもこの個室は、サーバ室へ続く通路の奥の、閉じた小部屋。用がなければ、誰も覗かない。
沢田はそのさなか、ストレージ警報で呼び戻された当番だった。「対応を終えて戻る時、この個室の灯りに気づいて……もう、冷たくなってて」。声が、わずかに揺れた。最後に戻った沢田が見つけるまで、異変に気づく者はいなかった——表向きは、そういうことになる。
社員証がなければ入れないフロアに、あの晩いたのは五人。いまは任意で事情聴取に応じ、別室に留まっている。「転倒でしょう」と、誰もがどこか縋るように言う。
だが旧友の死を、確定前のその一言で流す気にはなれない。解剖が下りる前の今のうちに、自分の目で現場を踏んでおく。
-> hub

