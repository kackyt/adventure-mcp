# title: 町田・深夜のEM変死事件 ― 第一章「町田」
// =====================================================================
//  ※本作はフィクション。登場人物・団体・出来事は実在のいかなるものとも無関係。
//    被害者・小田中育生は実在のエンジニア氏へのオマージュ（メタル/アジャイル/
//    北の出身という人となりを敬意を込めて借りるのみ）。本作の小田中は加害者では
//    なく、過去の隠蔽の当事者でもない（隠蔽したのは倉田ら別人）。彼はむしろ、
//    かつて声を上げられなかった悔いから、最後に真実を暴こうとして殺される側。
//  「旅するミステリ」全4章の第1章（縦スライス）。
//  全体構想は memory:machida-em-okhotsk を参照（章＝土地。現在の殺人の根は
//  過去の"隠蔽事件"にある。トーン重め・社会派。終着＝東京へ帰還し、ORACLE(AI×金×政治の
//  自動化された汚職)を止め、黒幕を暴く。DANFORTH＝海外の金主として背後に残す）。
//
//  ＜プレイヤー＝所轄の刑事。被害者・小田中とはつくば時代の旧友（公の権限＋私的動機）。
//    旧友からエンジニアリングを聞かされ続けた素地ゆえ、コミット/ログ/ボットの作為も読める。
//    東京帰還(終章)・椿の自死(3章)・AIいくお継承は、この"旧知"が動機の芯になる。＞
//  ＜固定コマンド（調査パレット）＞
//   あたりをみる / しらべる→対象 / きく→人物 / ばしょいどう→場所 /
//   てちょう（手帳：物証・捜査メモ）
//   ＊章末の移動先（次の土地）は、必須T1が揃うと「ばしょいどう」に出現＝それが合図。
//   ＊この章では犯人を挙げない。決め手＝立件は終章（東京帰還）。
//    第1章のゴール＝「事故では片づかない」疑念を物証で積む（殺人とも事件性とも断定しない）。
//    解剖前の初動という設定ゆえ、章末も"疑念止まり"でもやっと残す。過去への扉を開いて終わる。
//
//  ＜フラグ＝手帳の「捜査メモ」「物証アイテム」として可視化＞
//   必須T1（8）＝事件の像。全部揃うと「町田を発つ」が解禁（章ゲート。
//     丁寧に調べれば必ず揃う＝ソフトロック無し）。
//   引き継ぎ（3・奥まった/推理）＝真EDの鍵。取り逃しても発てるが、
//     全章で取り切らないと終章の真EDに届かない。2章以降へ持ち越す。
//
//  必須T1メモ/物証(9):
//   m_lastday 当日の足取り(被害者起点・聞き込みの前提) / m_wound 創傷の不一致 /
//   m_floor 血痕の不在 / m_drag 引きずり痕 / m_scene 真の現場 /
//   it_bar 凶器(金属バー) / m_cleanup 後始末痕 / m_timeline 在館タイムライン /
//   it_draft 盗用告発の草稿
//  引き継ぎ:
//   m_gap 経歴の空白(推理) / it_token 過去の符牒(奥まった) / m_echo 告発の裏(推理)
//
//  ＜真相（実装者向け・プレイ時伏せる／封印層）＞
//   死因は事故偽装、真の犯行現場はサーバ室、遺体は個室へ移動。真犯人と決め手は
//   終章で確定するため本章では伏せる。第1章は「転倒では説明がつかない疑念（遺体移動・凶器・
//   後始末・表の動機）」を積むに留め、断定しない。被害者の前職（機密流出の隠蔽の地）への手がかりを残す。
//
//  場所: 1=個室(現場) 2=開発フロア 3=サーバ室 4=廊下 5=警備室 6=給湯室
//  人物: 1=真鍋誠 2=西野薫 3=沢田亮 4=東巧 5=倉持百合
// =====================================================================

VAR loc = 1
VAR place = "小田中の個室"
VAR phase = 1

// --- 必須T1（9）---
VAR m_lastday = false    // 当日の足取り：手帳/予定表。22時以降が白紙＝予定外の動き
VAR m_wound = false      // 創傷の所見：二度打撲・机角と不一致
VAR m_floor = false      // 血痕の不在：ここで倒れていない
VAR m_drag = false       // 引きずり痕：遺体は運ばれた
VAR m_scene = false      // 真の現場：サーバ室
VAR it_bar = false       // 物証：非常用金属バー（凶器）
VAR m_cleanup = false    // 後始末痕：給湯室の濡れペーパー
VAR m_timeline = false   // 在館タイムライン：入退館＋カメラ
VAR it_draft = false     // 物証：盗用告発の草稿（表の動機）

// --- 引き継ぎ（3・奥まった/推理）---
VAR m_gap = false        // 経歴の空白（推理：表彰盾×在籍記録）
VAR it_token = false     // 過去の符牒（奥まった：海外・機密の気配）
VAR m_echo = false       // 告発の裏（推理：草稿×前職プロジェクト＝再演）

// --- 推理の素材（生の手がかり。単体では手帳に残らない）---
VAR r_oldjob = false     // 表彰盾に前職名
VAR r_tenure = false     // 在籍記録に不自然な空白
VAR r_project = false    // 西野が前職の"あるプロジェクト"に言及

// --- 容疑者の証言を聞いたか（手帳の彩り・裏取り）---
VAR t_manabe = false
VAR t_nishino = false
VAR t_sawada = false
VAR t_azuma = false
VAR t_kuramochi = false

// --- 進行 ---
VAR chapter = 1               // 1=町田 / 2=東京・現職
VAR murder_suspected = false  // m_wound && m_floor → phase2 解禁
VAR departed = false

// =====================================================================
//  第二章「東京・現職」（渋谷本社）の状態
//   ＜演繹＋帰納の融合パズル（本物の帰納＝試行→法則→新ケース適用）＞ "改竄者"を暴く。
//     演繹：夜間にリポジトリ権限を持つのは倉田と速水の2人→倉田は取締役会で拘束→速水に絞る。
//       速水は「承認も後始末も merge-guard の自動処理。設定はいじってない」と逃げる（最後の盾）。
//     帰納：merge-guard ボットの承認/却下ルールは非公開。属性（触るパス／ラベル）を変えた
//       ダミーPRを「ためす」→承認/却下を観察→隠れルールを立て、"新しい複数ケースの審判"
//       （問題数>実験回数）に通して確定する＝oracle_runes 型の本物の帰納。
//       導けるルール＝「/vendor/orion/ を触り auditラベルが無いPRだけ自動承認」。
//       汚染だけ素通しし監査だけ弾く"作為"のルール＝自動でなく人が仕込んだ証拠。
//     決め手：この隠れルールを速水に「つきつける」と、botの盾が砕けて割れる（演繹だけ／帰納だけでは届かない）。
// 生の手がかり
VAR r2_access = false         // 夜間リポジトリ権限者＝倉田と速水
VAR r2_kurata_alibi = false   // 倉田は取締役会の録画で拘束（除外）
VAR r2_hayami_claim = false   // 速水の「merge-guardの自動処理、設定はいじってない」主張
VAR r2_project = false        // 過去プロジェクト名「オリオン計画」を知る（速水を割ると判明）
// 必須T2（8）
VAR m2_theft = false          // 盗用の技術的実態（PR/差分）
VAR m2_report = false         // 告発の宛先と握り潰しの構図
VAR m2_tamper = false         // 事後改竄の痕（監査ブランチ削除＋merge-guard自動承認）
VAR m2_alibi = false          // 改竄者を速水に絞る（=r2_access && r2_kurata_alibi）
VAR it2_probe = false         // マージガードを十分に実験で探った（帰納の素材＝観察が貯まった）
VAR m2_rule = false           // 隠れルールを帰納し審判に通した（帰納成立＝決定的証拠）
VAR m2_tamper_id = false      // つきつけで速水を割った（改竄者確定）
VAR m2_keyperson = false      // 前職キーパーソンの特定
// マージガード実験の作業変数
VAR probe_count = 0           // 実験（ダミーPR）回数
VAR probe_path = 0            // 1=/vendor/orion/ 2=/src/ 3=/docs/
VAR probe_label = 0           // 1=無し 2=audit 3=hotfix
// 引き継ぎ（3・真EDの鍵）
VAR d2_suicide = false        // 過去に告発者が自死していた最初の影
VAR d2_secret = false         // 機密（輸出規制/DANFORTH）に触れていた確証
VAR d2_seed = false           // 終章への微かな違和（奥まった）
// つきつける
VAR accuse2 = 0
VAR evk2 = 0
VAR departed2 = false

// =====================================================================
//  第三章「つくば」（前職テクスフィアの地・盟友の自死の真相・小田中の原点）
//   ＜トリック＝嘘つき/証言の矛盾（演繹的再構成）＞ Ch1観察・Ch2帰納とは別系統。
//     盟友・椿直人の「自死」の夜、当時の関係者の証言が食い違う。物証（椿の遺した
//     KPTノートの最後の日付＋旧オフィスの来訪記録）と突き合わせ、高梨の嘘を暴く。
//     決め手＝矛盾の物証（来訪記録）を高梨に「つきつける」と割れる。
//   ＜人となり＞ 小田中＝"カイゼンの鬼"(アジャイル)なのに過去だけ放置した悔い。
//     メタルが盟友との符牒。新潟は二人の原点（彩り・里帰り）。
VAR r3_visit = false          // 旧オフィスの来訪記録（高梨が死亡時刻まで在館）
VAR r3_takagi_claim = false   // 高梨「あの夜は早く帰った」主張
VAR t3_takagi = false
VAR t3_takizawa = false
VAR m3_orion = false          // オリオンの機密インシデントの実在
VAR m3_friend = false         // 盟友＝椿直人（告発しようとした技術者）特定
VAR m3_kpt = false            // 椿の遺したKPTノート（物証・隠し書きの気配）
VAR m3_metal = false          // メタルの符牒（隠し書きの鍵）
VAR m3_decode = false         // KPTの隠し書き解読＝椿はDANFORTH取引の証拠を握っていた
VAR m3_testimony = false      // 当時の関係者の証言（高梨＆滝沢）
VAR m3_contradiction = false  // 証言×物証で矛盾を特定（高梨が嘘）
VAR m3_truth = false          // つきつけで高梨を割り、死の真相を確定
VAR d3_us = false             // 椿の証拠が指す先＝東京のORACLE本体（海外金主DANFORTHと結ぶ）→終章
VAR d3_seed = false           // 真犯人への布石（封印寄り・奥まった）
VAR d3_niigata = false        // 新潟の彩り：椿と小田中の原点（里帰り）
VAR accuse3 = 0
VAR evk3 = 0
VAR departed3 = false

// =====================================================================
//  終章「東京（帰還）」（事件解決＝プレイヤーの推理／ORACLE阻止＝AIいくお。2軸4ルート）
//   ＜ORACLE＞ オリオンの予測技術の進化形＝要人の弱みを採点し金と弱みで政治を動かす"自動化された汚職"。
//     西野が現職企業で設計・運用。DANFORTH＝海外の金主/データ源。椿・小田中はこれを止めようとして殺された。
//   ＜AIいくお＞ 椿と小田中がORACLEを止めるために作った対抗AI。起動キー＝半券(it_token)＋符牒(m3_metal)。
//     事件の謎解きには一切関与しない（時系列的に事件後を知り得ないため）。ORACLE阻止＝ai_booted で分岐。
//   ＜真犯人＝西野＞ プレイヤー自身の手帳推理（"サーバ室"の言い漏らし＝不可能知識）。AIいくお不要。
//   ＜4ルート＞ 1.沢田だけ(そうさをやめる) / 2.沢田+ORACLE失敗(未起動で踏み込む) /
//     3.沢田+ORACLE阻止(起動・黒幕未看破) / 4.沢田+西野+ORACLE阻止(真)。全ルートで沢田は立件済み。
VAR m4_terminal = false       // AIいくおの端末（小田中の遺品サーバ）を発見
VAR m4_oracle = false         // ORACLE計画（AIによる統治・支配）を確認
VAR boot_tried = false        // AIいくおの起動を試みた
VAR ai_booted = false         // 起動成功（= it_token && m3_metal を満たした）
// Phase A（全ED共通の推理：実働者を特定して検挙）
VAR m4_roster = false         // DANFORTHの内通者・支払記録（社内にモグラがいた）
VAR m4_link = false           // 内通者像の符合（サーバ室access＋第一発見者＋pageアリバイ偽装）
VAR m4_sawada = false         // 実働者＝沢田を検挙（"下っ端検挙"＝全EDの達成土台）
// Phase B（"裏切りの協力者"を暴く推理。プレイヤー自身が手帳を読み返す。AIいくお不要）
VAR heard_slip = false        // Ch2で西野の"サーバ室"の言い漏らしを聞いた（不可能知識の素材）
VAR m4_review = false         // 手帳を読み返し事件の構図を整理した（推理の盤面）
VAR m4_mastermind = false     // 黒幕を割った（封印）
// 終章の「つきつける」（実働者も黒幕も共通コマンドで名指し）
VAR accuse4 = 0               // 突きつける相手（1真鍋/2西野/3沢田/4東/5倉持/6倉田/7高梨/8ラップトップ）
VAR evk4 = 0                  // 突きつける証拠（1沢田立件/2黒幕立件/4ラップトップ起動）
// --- 終章「町田（帰還・再捜査）」用（AIいくお/ORACLE/西野の山とは独立） ---
VAR r4_plan = false           // 隠れ家：小田中の計画判明（裏口をサーバ室で開けに行った）＝殺しはサーバ室と確信＋動機
VAR r4_session = false        // サーバ室再検証：小田中が最後に触れた端末セッション（裏口を開けた証）
VAR r4_alert = false          // 警備室再検証：ストレージ警報は館内＝サーバ室から焚かれた（沢田の"呼ばれた"アリバイ捏造）

VAR public_status = "place"

-> intro

// =====================================================================
=== function bool_to_n(b) ===
{ b:
    ~ return 1
}
~ return 0

=== function t1_count() ===
~ return bool_to_n(m_lastday) + bool_to_n(m_wound) + bool_to_n(m_floor) + bool_to_n(m_drag) + bool_to_n(m_scene) + bool_to_n(it_bar) + bool_to_n(m_cleanup) + bool_to_n(m_timeline) + bool_to_n(it_draft)

=== function t1_complete() ===
~ return m_lastday && m_wound && m_floor && m_drag && m_scene && it_bar && m_cleanup && m_timeline && it_draft

=== function deep_count() ===
~ return bool_to_n(m_gap) + bool_to_n(it_token) + bool_to_n(m_echo)

=== function t2_count() ===
~ return bool_to_n(m2_theft) + bool_to_n(m2_report) + bool_to_n(m2_tamper) + bool_to_n(m2_alibi) + bool_to_n(it2_probe) + bool_to_n(m2_rule) + bool_to_n(m2_tamper_id) + bool_to_n(m2_keyperson)

=== function t2_complete() ===
~ return m2_theft && m2_report && m2_tamper && m2_alibi && it2_probe && m2_rule && m2_tamper_id && m2_keyperson

=== function deep2_count() ===
~ return bool_to_n(d2_suicide) + bool_to_n(d2_secret) + bool_to_n(d2_seed)

=== function who2(c) ===
{
- c == 1: ~ return "西野"
- c == 2: ~ return "速水"
- c == 3: ~ return "倉田"
- c == 4: ~ return "真壁"
- else:   ~ return "その人物"
}

=== function t3_count() ===
~ return bool_to_n(m3_orion) + bool_to_n(m3_friend) + bool_to_n(m3_kpt) + bool_to_n(m3_metal) + bool_to_n(m3_decode) + bool_to_n(m3_testimony) + bool_to_n(m3_contradiction) + bool_to_n(m3_truth)

=== function t3_complete() ===
~ return m3_orion && m3_friend && m3_kpt && m3_metal && m3_decode && m3_testimony && m3_contradiction && m3_truth

=== function deep3_count() ===
~ return bool_to_n(d3_us) + bool_to_n(d3_seed) + bool_to_n(d3_niigata)

=== function who3(c) ===
{
- c == 1: ~ return "高梨"
- c == 2: ~ return "滝沢"
- else:   ~ return "その人物"
}

=== function who4(c) ===
{
- c == 1: ~ return "真鍋"
- c == 2: ~ return "西野"
- c == 3: ~ return "沢田"
- c == 4: ~ return "東"
- c == 5: ~ return "倉持"
- c == 6: ~ return "倉田"
- c == 7: ~ return "高梨"
- else:   ~ return "その人物"
}

// 第3章：盟友の名「椿」は特定（m3_friend）するまで伏せる。未特定なら「盟友」と呼ぶ。
=== function tomo() ===
{
- m3_friend: ~ return "椿"
- else:      ~ return "盟友"
}

=== function deep_total() ===
~ return deep_count() + deep2_count() + deep3_count()

=== function enough_truth() ===
~ return deep_total() >= 7

=== function key_item() ===
// AIいくおの起動キー：DANFORTH半券＋メタル符牒
~ return it_token && m3_metal

=== function can_unmask() ===
// 黒幕を割る土台（AIいくお不要・プレイヤーの推理）：西野の言い漏らしを聞いた(heard_slip)＋
// 手帳を整理した盤面(m4_review)＋写真の"もう一人"(d3_seed)。"誰の言葉に不可能知識があるか"はプレイヤーが見抜く
~ return heard_slip && m4_review && d3_seed

// =====================================================================
=== intro ===
※本作はフィクションです。登場する人物・団体・出来事は、実在のいかなるものとも関係ありません。

前夜遅く、町田駅から徒歩十分、雑居ビル7階の開発オフィスで、人が死んだ。
リリースの夜だった。残業の波が引いたあと、奥まった小部屋で一人、Engineering Manager・小田中育生(38)が倒れているのを、警報で呼び戻された当番の社員が見つけ、110番した。
病死でも、ひと目で分かる事故でもない——医者の看取らぬ死は、ひとまず「変死」として扱われる。所轄が臨場し、検視官が呼ばれ、現場は保全された。事件性の有無を見極める。それが初動だ。

未明。応援に駆けつけたあなたは、遺体の顔に、息が止まった。
小田中育生。つくばで机を並べた、古い友人だ。十年も会っていない。だが、カイゼンだアジャイルだと一晩じゅう語り倒したあの男を、忘れるはずがない。
私情は、伏せておく。今は一人の刑事として、現場を踏む。まずは状況からだ。
-> prologue_brief

=== prologue_brief ===
検視官が遺体の傍らで顔を上げた。「外表所見では、致命傷は後頭部の打撲。机の角に頭を打っての転倒——筋は通ります。ただ、確定は解剖を待ってください」。机の角には、確かに血。
「死亡推定は」。「体温と硬直からみて、死後およそ二、三時間。前夜の二十二時から二十三時のあたりでしょう。見つかったのが零時前ですから、亡くなってからしばらく、誰にも気づかれずにいた計算です」。
その晩はリリースの夜で、社員たちは思い思いの時間まで残り、入れ替わりに引き上げていた。沢田はそのさなか、ストレージ警報で呼び戻された当番だ。「対応を終えて戻る時、この個室の灯りに気づいて……もう、冷たくなってて」。声が、わずかに揺れた。
個室は通路の奥に閉じた小部屋。皆が別々の時間に去ったあと、最後に戻った沢田が見つけるまで、誰も異変に気づかなかった——表向きは、そういうことになる。
社員証がなければ入れないフロアに、あの晩いたのは五人。いまは任意で事情聴取に応じ、別室に留まっている。「転倒でしょう」と、誰もがどこか縋るように言う。
だが旧友の死を、確定前のその一言で流す気にはなれない。解剖が下りる前の今のうちに、自分の目で現場を踏んでおく。（コマンドは「てちょう」で手帳を確認できる）
-> hub

// =====================================================================
=== hub ===
+ [あたりをみる] -> v_look
+ [しらべる] -> v_examine
+ {loc == 2 && m_lastday} [きく] -> v_ask
+ {loc == 2 && not m_lastday} [きく（まだ聞き込みは早い）] -> ask_too_early
+ [ばしょいどう] -> v_move
+ [てちょう] -> v_techou

=== ask_too_early ===
順序が逆だ。関係者を割るのは、まず被害者の当日を掴んでからだ。小田中が最後の一日、どこで何をして、どこへ向かおうとしていたのか——個室の机から、足取りを追え。
-> hub

// =====================================================================
=== v_look ===
{
- loc == 1: 小田中の個室。机の角に血の跡、床に倒れた体。ノートPC、引き出し付きの机、壁には表彰の盾がいくつか。一見、転倒事故。ドアは開発フロアへ。
- loc == 2: 開発フロア。あの晩、入れ替わりに居合わせた五人——真鍋、西野、沢田、東、倉持。聞き取りのため呼び戻され、皆、顔色が悪い。通路はサーバ室・廊下・警備室・給湯室、そして個室へ。
- loc == 3: { phase >= 2: サーバ室。ラックの唸り。床の一角に拭き残した染み、倒れかかった機材。ラックの裏に、何か落ちていないか。| サーバ室。今はただ機械が唸るだけ。何を探すべきか、まだ絞れない。}
- loc == 4: { phase >= 2: 個室とサーバ室を繋ぐ廊下。斜めの光に、細く長い擦過の筋が見える。| 個室とサーバ室を繋ぐ薄暗い廊下。今は気にならない。}
- loc == 5: 警備室。社員証の入退館ログ端末、警備カメラのモニタ、オンコールのページャ記録。
- loc == 6: 給湯室。流しと自販機、戸棚。深夜まで人が出入りする。
}
-> hub

// =====================================================================
=== v_examine ===
何を調べる？
// --- 個室(loc1) ---
+ {loc == 1} [机上の手帳と当日の予定表を読む] -> ex_lastday
+ {loc == 1} [遺体の傷を検める] -> ex_wound
+ {loc == 1} [床] -> ex_floor
+ {loc == 1} [机の引き出し] -> ex_draft
+ {loc == 1} [壁の表彰盾] -> ex_plaque
+ {loc == 1} [ノートPCと在籍記録] -> ex_tenure
+ {loc == 1 && r_oldjob && r_tenure} [二つの経歴を突き合わせる] -> ex_gap
// --- 廊下(loc4・phase2) ---
+ {loc == 4 && phase >= 2} [床の擦過の筋] -> ex_drag
// --- サーバ室(loc3・phase2) ---
+ {loc == 3 && phase >= 2} [床の染みと機材の乱れ] -> ex_scene
+ {loc == 3 && phase >= 2} [ラック脇の非常用工具] -> ex_bar
+ {loc == 3 && phase >= 2} [ラックの裏をのぞく] -> ex_token
// --- 給湯室(loc6) ---
+ {loc == 6} [流しと洗い場] -> ex_cleanup
// --- 警備室(loc5) ---
+ {loc == 5} [入退館ログと警備カメラ] -> ex_timeline
+ {loc == 5} [ページャ（オンコール）記録] -> ex_pager
// --- 開発フロア(loc2) ---
+ {loc == 2 && it_draft && r_project} [盗用告発の草稿を読み返す] -> ex_echo
+ [やめる] -> hub

// ---- 個室 ----
=== ex_lastday ===
机上に、小田中の手帳。当日の頁は、朝から1on1がびっしり——部下一人ひとりの欄に、几帳面な赤字でKPTのメモが添えてある。"カイゼンの鬼"は、人生の最後の日まで、人に向き合っていた。夕方にリリース立ち会い。20時台に「報告　＊明日」とだけ走り書き。
だが、22時以降の予定は白紙だ。
~ m_lastday = true
-> hub
=== ex_wound ===
後頭部の傷は一つではない。深い打撲が二度。机の角は鋭く尖っているのに、傷は平らで幅広い。「転んで角に一度」では、こうはならない。（手帳に記した：創傷の不一致）
~ m_wound = true
-> check_phase2
=== ex_floor ===
倒れていた割に、床の血痕がほとんど無い。机角の血も、塗りつけたように不自然だ。ここで頭を打って倒れたのなら、こんなに綺麗なはずがない。（手帳に記した：血痕の不在）
~ m_floor = true
-> check_phase2
=== ex_draft ===
引き出しの奥に、印刷された草稿メモ。宛先は経営層。「東巧のコミットに、外部OSSからの無断流用を複数確認。今週中に正式に報告する」。小田中の署名入り。（盗用告発の草稿を手に入れた）
~ it_draft = true
-> hub
=== ex_plaque ===
壁の表彰盾。社内表彰に混じって、見慣れぬ社名の盾が一つ——「テクスフィア・システムズ 殊勲賞」。小田中の、前職のものらしい。（前職名を覚えた）
~ r_oldjob = true
-> hub
=== ex_tenure ===
ノートPCはロック中。だが横に貼られた人事カードの控えに、入社年と職歴の欄。現職の前、数年分の在籍がぽっかり空白で、前職の退職理由は「一身上の都合」とだけ。妙に急いで職を変えている。（在籍の空白が引っかかる）
~ r_tenure = true
-> hub
=== ex_gap ===
表彰盾の「テクスフィア・システムズ」と、履歴の空白を突き合わせる。数年前、殊勲賞を受けるほどの働きをしながら、小田中はその会社を突然辞め、経歴を濁している。栄光と空白が同居している——何かを置いて逃げた者の足跡だ。（手帳に記した：経歴の空白）
~ m_gap = true
-> hub

// ---- 廊下 ----
=== ex_drag ===
廊下の床、個室からサーバ室の方向へ——細く長い擦過の筋が二条。重い物を踵で引きずった跡だ。点々と、拭き残した微かな染みも続く。（手帳に記した：引きずり痕＝遺体は運ばれた）
~ m_drag = true
-> hub

// ---- サーバ室 ----
=== ex_scene ===
サーバ室の床の一角。拭いた跡の縁に、ラックの脚の陰に残った血溜まりの縁。近くのラックには倒れかかった機材、争ったような乱れ。ここで人が倒れた——間違いない。（手帳に記した：真の現場＝サーバ室）
~ m_scene = true
-> hub
=== ex_bar ===
ラック脇の非常用の金属バー。平らで幅広い面が、後頭部の傷とぴたりと符合する。柄は最近になって拭われている。（物証：金属バーを確保した）
~ it_bar = true
-> hub
=== ex_token ===
ラックの裏に手を伸ばすと、埃と一緒に古い物が落ちている——色褪せた入館証の半券。英語表記、ロゴは星条旗を思わせる意匠、下に「DANFORTH AEROSPACE / VISITOR」。なぜこんな物が、ここに。
半券に挟まって、破れた走り書きの切れ端。まぎれもなく小田中の字だ。「……おれに何かあったら、"いくお"を起こせ。鍵は二つ。ひとつは、こい——」そこで紙は千切れ、続きは無い。（物証：過去の符牒／"いくお"と二つの鍵?）
~ it_token = true
-> hub

// ---- 給湯室 ----
=== ex_cleanup ===
流しの三角コーナーに、濡れたペーパータオルが大量に。誰かが深夜、何かを大急ぎで拭き取ったらしい。血の匂いが、まだ微かに残る。（手帳に記した：後始末痕）
~ m_cleanup = true
-> hub

// ---- 警備室 ----
=== ex_timeline ===
入退館ログと警備カメラを突き合わせる。
　真鍋：21:40退館／西野：22:10退館／倉持：23:30退館。
　東：当夜の退館記録なし（フロアに残留）／沢田：23:20入館。
　小田中：入館のみ、退館記録なし。
カメラには、小田中が個室から廊下へ出る22:35の姿が最後。死亡はその後、深夜のこの時間帯だ。（手帳に記した：在館タイムライン）
~ m_timeline = true
-> hub
=== ex_pager ===
オンコールのページャ記録。23:10、ストレージ警報で発報。当番の沢田が応答し、23:20入館してサーバ室へ直行している。沢田は"業務として"サーバ室を知り得る立場だ。
-> hub

// ---- 開発フロア ----
=== ex_echo ===
盗用告発の草稿を、西野の話を踏まえて読み返す。OSSの無断流用——同じ構図を、小田中は前職でも見ている。いや、見ていたどころではない。告発する側と、される側。今のこれは、過去の"何か"の再演ではないか。（手帳に記した：告発の裏＝再演の気配）
~ m_echo = true
-> hub

